# 栖林商店容器部署配置。复制到仓库根的 .env（已在 .gitignore 里）：
#   cp deploy/docker/.env.example .env && chmod 600 .env
#
# 只有 QILIN_PUBLIC_BASE 和（用容器 Caddy 时）QILIN_DOMAIN 是必填语义项。

# ---------- 对外地址 ----------
# 反代之后必须写成用户实际打开的 https 地址。留空时应用会按 Host 头推断，
# 那样下发的 MCP 配置与安装计划可能是 http 或内网地址。
QILIN_PUBLIC_BASE=https://qilin.example.com

# ---------- 端口与绑定 ----------
# 宿主只绑回环；公网 443 由反代接管。
QILIN_BIND=127.0.0.1
# 宿主侧映射端口（容器内固定 8787，不要去改容器里的 QILIN_PORT）。
QILIN_HOST_PORT=8787

# ---------- 镜像与资源 ----------
QILIN_IMAGE=qilin:local
PYTHON_VERSION=3.13
# 内网私仓构建时可覆盖基础镜像与 PyPI 索引源：
# PYTHON_IMAGE=10.37.87.22:5000/library/python:3.13-slim-bookworm
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
QILIN_UID=10001
QILIN_GID=10001
# 单进程 CPU 上限；scrypt 在登录时占 16MB 内存，512M 足够十来个并发登录。
QILIN_CPUS=1.0
QILIN_MEMORY=512M

# ---------- 日志 ----------
# WARNING / INFO / DEBUG。DEBUG 会记录每条业务拒绝，排障时临时打开。
QILIN_LOG_LEVEL=WARNING
# 1 = 记录每个 HTTP 请求到 stderr（docker logs 可见）
QILIN_ACCESS_LOG=0
TZ=Asia/Shanghai

# ---------- 反向代理 ----------
# 1 = 读 X-Real-IP / X-Forwarded-For 作为限流键。
# 当 8787 暴露在局域网（如 QILIN_BIND=0.0.0.0）时，务必同时设置 QILIN_TRUSTED_PROXIES
# 限定仅信任反向代理节点的来源 IP，防止客户端直连 8787 伪造转发头绕过限流。
QILIN_TRUST_PROXY=1
QILIN_TRUSTED_PROXIES=127.0.0.1,::1

# ---------- 外部地址（用容器 Caddy 时必填） ----------
QILIN_DOMAIN=qilin.example.com

# ---------- 数据目录 ----------
# 宿主目录，属主须为 QILIN_UID；先执行：
#   sudo install -d -o 10001 -g 10001 -m 0750 /srv/qilin/data
# 已有部署的商品从旧的 var/ 迁进来：见 deploy/docker/import-existing-data.sh
QILIN_DATA_DIR=/srv/qilin/data

# ---------- 备份 ----------
# 宿主目录，属主须为 QILIN_UID；先执行：
#   sudo install -d -o 10001 -g 10001 -m 0750 /srv/qilin/backups
QILIN_BACKUP_DIR=/srv/qilin/backups
QILIN_BACKUP_KEEP=14

# ---------- 外部地址抓取 ----------
# 上传校验时服务端会替提交者抓一次清单里的地址（评审 P1-3）。
# public：只访问公网（默认）；allowlist：只访问下面列出的主机；any：全放开。
QILIN_FETCH_POLICY=public
# 内网资源白名单，逗号分隔的主机名或域名后缀，例如 internal.corp,10.1.2.3
QILIN_FETCH_ALLOW_HOSTS=
# 外部依赖说明 URL 的探活策略：
# strict = 不可达则停在 uploading（公网默认）；warn = 不可达记为 warning 不阻断（内网推荐）；off = 跳过探测
QILIN_URL_CHECK=warn

# ---------- 注册开关 ----------
# open（默认）：自助注册开放，只产生作者；closed：关闭自助注册，由管理员开号。
QILIN_REGISTRATION=open

# ---------- 实验室枢纽（不接就留空） ----------
# QILIN_HUB_ORIGIN=https://hub.example.com
# QILIN_APP_ID=lucy-qilin
# QILIN_HUB_AUTHORIZE=https://hub.example.com/authorize?state={state}&redirect_uri={redirect_uri}&app_id={app_id}
#
# 密钥二选一：
# 1) 文件（推荐）：把文件挂进容器，再设 QILIN_HUB_SECRET_FILE
#    QILIN_HUB_SECRET_FILE=/run/secrets/qilin_hub_secret
# 2) 环境变量（会出现在 docker inspect 里，仅限可信宿主）
#    QILIN_HUB_SECRET=...
