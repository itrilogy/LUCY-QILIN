# 只保留 https server；证书路径按实际替换。
server {
    listen 443 ssl http2;
    server_name qilin.example.com;

    ssl_certificate     /etc/letsencrypt/live/qilin.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/qilin.example.com/privkey.pem;

    # 32 MiB 制品走 base64 上传，留足余量。
    client_max_body_size 64m;

    # 一次性上传地址含 ?ticket= 能力票据：调大请求体内存缓冲避免落临时文件打 warn 日志，
    # 并关闭该路径的明文 access_log（审计由应用层脱敏记录）。
    location /v1/uploads/ {
        access_log off;
        client_body_buffer_size 2m;
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_buffering off;
        proxy_read_timeout 300s;
    }
}
